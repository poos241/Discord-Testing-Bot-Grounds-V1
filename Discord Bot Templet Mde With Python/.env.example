# Copy this file to .env and fill in your bot token.
# (setup.py does this for you automatically.)
TOKEN2=paste-your-bot-token-here

# ---- Bot/website bridge (November 2026: two separate processes) ----
# Shared secret the bot and the website use to talk over the local
# bridge API. Required: without it the bridge will not start and live
# website pages degrade to "bot unavailable". Generate a long random
# string and keep it private (never commit .env).
BRIDGE_SECRET=paste-a-long-random-secret-here
# Optional: bridge port (default 5001) and toggle (BRIDGE_ENABLED=0
# turns the bridge off entirely).
# BRIDGE_PORT=5001

# ---- Web dashboard (Discord OAuth login) ----
# The website runs as its own process now (python run_web.py, or
# run_web.bat); WEB_ENABLED is no longer read by the bot.
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Random secret for web sessions (generate one, keep it private).
WEB_SECRET_KEY=paste-a-random-secret-here
# Discord application credentials (https://discord.com/developers/applications).
DISCORD_CLIENT_ID=paste-your-application-id-here
DISCORD_CLIENT_SECRET=paste-your-client-secret-here
# Must match the redirect URI registered in the Discord developer portal.
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/callback
