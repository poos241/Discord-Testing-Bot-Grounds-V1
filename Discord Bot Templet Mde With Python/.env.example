# Copy this file to .env and fill in your bot token.
# (setup.py does this for you automatically.)
TOKEN2=paste-your-bot-token-here

# ---- Web dashboard (Discord OAuth login) ----
# Set WEB_ENABLED=false to run the bot without the dashboard.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=5000
# Random secret for web sessions (generate one, keep it private).
WEB_SECRET_KEY=paste-a-random-secret-here
# Discord application credentials (https://discord.com/developers/applications).
DISCORD_CLIENT_ID=paste-your-application-id-here
DISCORD_CLIENT_SECRET=paste-your-client-secret-here
# Must match the redirect URI registered in the Discord developer portal.
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/callback
